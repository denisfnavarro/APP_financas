# Supabase → Project Settings → API
# Sem o prefixo NEXT_PUBLIC_ de propósito: tudo que é NEXT_PUBLIC_ vai parar no
# JavaScript que o navegador baixa. Aqui as chaves ficam só no servidor.
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Projetos novos chamam de "publishable key" (sb_publishable_...);
# os antigos, de "anon public". Serve a mesma variável.
SUPABASE_ANON_KEY=sua-chave-anon-ou-publishable

# Origem pública do app, usada no link de confirmação de e-mail.
# Em desenvolvimento, deixe como está. Na Vercel pode omitir:
# a VERCEL_PROJECT_PRODUCTION_URL é detectada automaticamente.
SITE_URL=http://localhost:3000
